{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    // single source for these aliases: vite.config.ts derives resolve.alias from them
    "paths": {
      "$root/*": ["../*"],
      "$data/*": ["../data/*"],
      "$pkg/*": ["../matbench_discovery/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*.ts", "vite.config.ts"]
}
