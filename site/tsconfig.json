{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    // svelte-check is the only Svelte-aware linter for script-only names; oxlint skips .svelte
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // single source for these aliases: vite.config.ts derives resolve.alias from them
    "paths": {
      "$root/*": ["../*"],
      "$pkg/*": ["../matbench_discovery/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*.ts", "vite.config.ts"]
}
