{
  "name": "matbench-discovery",
  "description": "Benchmarking ML force fields across crystal discovery, geometry optimization, phonons, molecular dynamics, and diatomics.",
  "homepage": "https://matbench-discovery.materialsproject.org",
  "bugs": "https://github.com/janosh/matbench-discovery/issues",
  "license": "MIT",
  "author": "Janosh Riebesell <janosh.riebesell@gmail.com>",
  "repository": "https://github.com/janosh/matbench-discovery",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*",
    "#figs/*": "./src/figs/*",
    "#routes/*": "./src/routes/*",
    "#site/*": "./*"
  },
  "scripts": {
    "dev": "node scripts/fetch-parity-assets.ts && vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "fetch:parity": "node scripts/fetch-parity-assets.ts",
    "test": "vp test run",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt --write",
    "fetch:github-activity": "node --experimental-strip-types scripts/fetch-mlip-repos-github-activity.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-array": "^3.2.2",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.5",
    "@wooorm/starry-night": "^3.11.0",
    "d3-array": "^3.2.4",
    "happy-dom": "^21.0.3",
    "json-schema-to-typescript": "^16.0.0",
    "matterviz": "github:janosh/matterviz#main",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-widgets": "github:janosh/svelte-widgets#main",
    "temml": "^0.14.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "packageManager": "pnpm@12.14.0",
  "author-url": "https://janosh.dev",
  "doi": "https://doi.org/10.1038/s42256-025-01055-1",
  "github-pages": "https://janosh.github.io/matbench-discovery",
  "package": "https://pypi.org/project/matbench-discovery",
  "paper": "https://nature.com/articles/s42256-025-01055-1",
  "preprint": "https://arxiv.org/abs/2308.14920",
  "title": "Matbench Discovery"
}
